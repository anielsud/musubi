<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Filled in by scripts/install-recorder.sh: __EXECUTABLE__ is the
     recorder inside the installed app, __DATA__ its data folder. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.anielsud.musubi.recorder</string>
	<key>ProgramArguments</key>
	<array>
		<string>__EXECUTABLE__</string>
		<string>run</string>
		<string>--data</string>
		<string>__DATA__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restarted whenever it stops, a clean exit included: a recorder
	     that isn't running loses meetings without anyone noticing. Only
	     launchctl bootout (installs, on purpose) stops it for good. -->
	<key>KeepAlive</key>
	<true/>
	<!-- A start that keeps failing (no models, say) retries once a minute,
	     not every ten seconds. -->
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<!-- Live audio: not throttled like a background job. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>__DATA__/logs/recorder.log</string>
	<key>StandardErrorPath</key>
	<string>__DATA__/logs/recorder.log</string>
</dict>
</plist>
